  "cards": [
    {
      "dot": "violet",
      "title": "Primary records",
      "items": [
        "Program.FrameworkId binds one expert-owned framework to a curriculum.",
        "CurriculumReview stores each expert decision and criterion scores.",
        "ClassSessionExpert stores invite state and private mentor feedback."
      ]
    },
    {
      "dot": "amber",
      "title": "Security observations",
      "items": [
        "Password hashes use PBKDF2-HMAC-SHA256 with a random salt and constant-time verification.",
        "JWTs are HMAC-SHA256 signed; frontend keeps access and refresh tokens in sessionStorage.",
        "Refresh tokens are generated cryptographically but are persisted as raw values, not hashes."
      ]
    }
  ]
