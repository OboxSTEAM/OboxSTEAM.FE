    { "id": "apiclient", "type": "security", "label": "API client", "sublabel": "JWT, refresh, response parse", "stage": 1, "row": 2, "width": 154 },
    { "id": "controllers", "type": "backend", "label": "API controllers", "sublabel": "typed DTO and role check", "stage": 2, "row": 1, "width": 154 },
    { "id": "services", "type": "backend", "label": "Expert services", "sublabel": "framework, review, co-teach", "stage": 3, "row": 1, "width": 166 },
    { "id": "postgres", "type": "database", "label": "PostgreSQL", "sublabel": "EF Core UnitOfWork", "stage": 4, "row": 0, "width": 154 },
