# Copy to e2e/.env.test (gitignored) for local Playwright runs against staging.
# In CI, set these as GitHub Actions secrets/variables when E2E_BASE_URL points at staging.

E2E_BASE_URL=https://staging.oboxsteam.website
E2E_API_URL=https://staging-api.oboxsteam.com

E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=

E2E_PARENT_EMAIL=
E2E_PARENT_PASSWORD=

E2E_MENTOR_EMAIL=
E2E_MENTOR_PASSWORD=

E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=

# Known stable entities on staging (fill after BE seeds test data)
E2E_TEST_PROGRAM_ID=
E2E_TEST_PROGRAM_SLUG=
E2E_PORTFOLIO_SUBDOMAIN=
